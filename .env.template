# PDF Split and Rotate Service Configuration Template
# Copy this file to .env and modify as needed

# Basic Paths
WATCH_FOLDER=C:\staging
OUTPUT_FOLDER=C:\staging_out
PROCESSED_FILE_PATH=./logs/processed_files.txt
ERROR_LOG_PATH=./logs/error_log.txt
WARNINGS_LOG_PATH=./logs/warnings_log.txt

# Core Processing Settings
MAX_WORKERS=40
FILENAME_SEPARATOR=__EKR__
MAX_FILES_PER_GROUP=10000
REMOVE_SOURCE_FILE=false
RESET_PROGRESS=false

# File Readiness Settings
FILE_READY_RETRIES=100
FILE_READY_DELAY=5.0

# Network Resilience Settings (Critical for Network Shares)
NETWORK_TIMEOUT=600.0
NETWORK_RETRY_ATTEMPTS=20
NETWORK_RETRY_BACKOFF=2.0
NETWORK_RETRY_MAX_DELAY=120.0

# Circuit Breaker Settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=15
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=600.0

# Advanced Concurrency Settings
IO_THREAD_WORKERS=32
CPU_PROCESS_WORKERS=48
QUEUE_MAX_SIZE=2000
MEMORY_LIMIT_MB=40960

# File Locking Settings (Critical for Network Shares)
FILE_LOCK_TIMEOUT=1200.0
FILE_LOCK_HEARTBEAT_INTERVAL=10.0
STALE_LOCK_CLEANUP_INTERVAL=600.0

# Batch Processing Settings
BATCH_SIZE=40