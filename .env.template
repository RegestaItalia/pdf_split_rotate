# NETWORK_RETRY_ATTEMPTS=10
# FILE_LOCK_TIMEOUT=300.0
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=20
# CIRCUIT_BREAKER_RECOVERY_TIMEOUT=900.0
