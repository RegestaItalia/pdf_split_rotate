# PDF Split Rotate - Metadata Collector Configuration

# Folder containing the processed output files (customer folders with groups)
METADATA_OUTPUT_FOLDER=./output

# Folder containing the original source files (for cross-referencing)
METADATA_INPUT_FOLDER=./input

# Output file for the metadata analysis (Parquet format)
METADATA_OUTPUT_FILE=./metadata_analysis.parquet

# Number of worker threads for parallel file processing
METADATA_MAX_WORKERS=8

# Number of worker threads for cache building and directory scanning (typically higher for I/O)
METADATA_CACHE_WORKERS=16

# Filename separator used in the original processing
FILENAME_SEPARATOR=__EKR__

# Chunk size for batch processing large datasets
METADATA_CHUNK_SIZE=1000

# Batch size for parallel file system operations during cache building
CACHE_BATCH_SIZE=500

# Enable/disable source file lookup (set to 'false' to skip source file analysis)
ENABLE_SOURCE_LOOKUP=true

# Report Generation Configuration
# Input Parquet file for report generation
REPORT_INPUT_FILE=./metadata_analysis.parquet

# Output HTML report file
REPORT_OUTPUT_FILE=./metadata_report.html

# Report title
REPORT_TITLE=PDF Split Rotate - Processing Report

# Include detailed summary tables in the report
INCLUDE_DETAILED_TABLES=true

# Maximum number of customers to display in charts (for readability)
MAX_CUSTOMERS_DISPLAY=20

# Color scheme for charts (plotly, viridis, plasma, inferno, etc.)
COLOR_SCHEME=plotly
